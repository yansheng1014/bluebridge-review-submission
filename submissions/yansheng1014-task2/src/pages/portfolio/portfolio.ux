<template>
  <div class="page" style="{{t.page}}">
    <div class="topbar" style="{{t.topbar}}">
      <div class="back-hit" onclick="back">
        <image class="back-icon" src="{{t.iconBack}}"></image>
      </div>
      <text class="top-title" style="{{t.text}}">持仓</text>
      <text class="top-meta" style="{{t.sub}}">{{holdingCountText}}</text>
    </div>
    <div class="content-layer flow-content-layer" style="{{t.page}}">
      <scroll class="portfolio-scroll" scroll-y="true" scroll-x="false" style="{{t.page}}">
        <div class="summary" style="{{t.card}}">
          <div class="summary-metric">
            <text class="summary-label" style="{{t.sub}}">持仓市值</text>
            <text class="summary-value" style="{{t.text}}">{{holdingText}}</text>
          </div>
          <div class="summary-metric profit-metric">
            <text class="summary-label" style="{{t.sub}}">浮动盈亏</text>
            <text class="summary-profit {{profitClass}}">{{profitText}}</text>
          </div>
        </div>
        <div class="holding-row" for="{{holdings}}" tid="id" onclick="openStock($item.id)" style="{{t.card}}">
          <div class="holding-logo {{$item.avatarClass}}">
            <text class="holding-mark" style="{{t.text}}">{{$item.mark}}</text>
          </div>
          <div class="holding-main">
            <text class="row-title" style="{{t.text}}">{{$item.name}}</text>
            <text class="row-sub" style="{{t.sub}}">{{$item.sharesText}} · {{$item.costText}}</text>
          </div>
          <div class="holding-side">
            <text class="holding-price" style="{{t.text}}">{{$item.priceText}}</text>
            <text class="holding-profit {{$item.profitClass}}">{{$item.profitText}}</text>
          </div>
        </div>
        <text class="portfolio-note" style="{{t.muted}}">以上为固定演示持仓，仅用于界面展示。</text>
      </scroll>
    </div>
  </div>
</template>
<script>
import router from "@system.router"
import {
  formatMoney,
  formatSignedMoney,
  heldStocks,
  stockHoldingProfit,
  totalHoldingValue,
  totalHoldingProfit,
  trendClass
} from "../../data/reviewStatic.js"
import { applyTheme, DEFAULT_STYLES } from "../../common/theme.js"
export default {
  private: {
    t: DEFAULT_STYLES,
    holdingCountText: "0 支",
    holdingText: "",
    profitText: "",
    profitClass: "neutral",
    holdings: []
  },
  onInit() {
    applyTheme(this)
    const rows = heldStocks()
    const profit = totalHoldingProfit()
    this.holdingCountText = rows.length + " 支"
    this.holdingText = formatMoney(totalHoldingValue())
    this.profitText = formatSignedMoney(profit)
    this.profitClass = trendClass(profit)
    this.holdings = rows.map(function (stock) {
      const itemProfit = stockHoldingProfit(stock)
      return {
        id: stock.id,
        name: stock.name,
        mark: stock.mark,
        avatarClass: stock.avatarTone,
        sharesText: stock.holding.shares + " 股",
        costText: "成本 " + formatMoney(stock.holding.averageCost),
        priceText: formatMoney(stock.price),
        profitText: formatSignedMoney(itemProfit),
        profitClass: trendClass(itemProfit)
      }
    })
  },
  onShow() {
    applyTheme(this)
  },
  back() {
    router.back()
  },
  openStock(stockId) {
    router.push({ uri: "/pages/stock-detail", params: { stockId: stockId } })
  }
}
</script>
<style>
@import "../../common/theme.css";
.portfolio-scroll { width: 336px; height: 408px; padding: 0 8px 24px 8px; flex-direction: column; background-color: #000000; }
.summary { width: 320px; height: 142px; margin-bottom: 8px; padding: 11px 14px; border-radius: 22px; flex-direction: column; background-color: #171717; }
.summary-metric { width: 292px; height: 58px; flex-direction: column; }
.profit-metric { margin-top: 4px; }
.summary-label { width: 292px; height: 24px; color: #a0a0a0; font-size: 19px; line-height: 24px; lines: 1; }
.summary-value { width: 292px; height: 34px; color: #ffffff; font-size: 31px; line-height: 34px; font-weight: bold; lines: 1; text-overflow: ellipsis; }
.summary-profit { width: 292px; height: 34px; font-size: 27px; line-height: 34px; font-weight: bold; lines: 1; text-overflow: ellipsis; }
.holding-row { width: 320px; height: 108px; margin-bottom: 8px; padding: 12px; border-radius: 22px; flex-direction: row; align-items: center; background-color: #171717; }
.holding-logo { width: 72px; height: 72px; margin-right: 10px; border-radius: 20px; align-items: center; justify-content: center; }
.holding-mark { width: 72px; height: 72px; color: #ffffff; font-size: 42px; line-height: 72px; font-weight: bold; text-align: center; }
.avatar-blue { background-color: #102b49; }
.avatar-gold { background-color: #332b08; }
.avatar-green { background-color: #10351e; }
.avatar-red { background-color: #4a171b; }
.avatar-purple { background-color: #2d1b4e; }
.avatar-gray { background-color: #343438; }
.holding-main { width: 128px; height: 72px; flex-direction: column; justify-content: center; }
.holding-side { width: 86px; flex-direction: column; align-items: flex-end; }
.holding-price { width: 86px; height: 34px; color: #ffffff; font-size: 27px; line-height: 34px; font-weight: bold; text-align: right; lines: 1; text-overflow: ellipsis; }
.holding-profit { width: 86px; height: 28px; margin-top: 3px; font-size: 21px; line-height: 28px; font-weight: bold; text-align: right; lines: 1; text-overflow: ellipsis; }
.portfolio-note { width: 320px; height: 30px; margin-top: 4px; color: #636366; font-size: 15px; line-height: 30px; text-align: center; }
</style>
