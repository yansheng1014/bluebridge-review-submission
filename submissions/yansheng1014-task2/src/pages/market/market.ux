<template>
  <div class="page" style="{{t.page}}">
    <div class="topbar" style="{{t.topbar}}">
      <div class="back-hit" onclick="back">
        <image class="back-icon" src="{{t.iconBack}}"></image>
      </div>
      <text class="top-title" style="{{t.text}}">股市</text>
      <text class="top-meta" style="{{t.sub}}">第 {{gameDay}} 日</text>
    </div>
    <div class="content-layer flow-content-layer" style="{{t.page}}">
      <list class="list-body" bounces="true" style="{{t.page}}">
        <list-item class="stock-row" type="stock" for="{{stocks}}" tid="id" onclick="openStock($item.id)" style="{{t.card}}">
          <div class="stock-logo {{$item.avatarTone}}">
            <text class="stock-mark" style="{{t.text}}">{{$item.mark}}</text>
          </div>
          <div class="stock-main">
            <text class="stock-name" style="{{t.text}}">{{$item.name}}</text>
            <text class="row-sub" style="{{t.sub}}">{{$item.holdingText}}</text>
          </div>
          <div class="price-box">
            <text class="stock-price" style="{{t.text}}">{{$item.priceText}}</text>
            <text class="{{$item.changeClass}}">{{$item.changeText}}</text>
          </div>
        </list-item>
      </list>
      <image class="fade-top" src="{{t.fadeTop}}"></image>
      <image class="fade-bottom" src="{{t.fadeBottom}}"></image>
    </div>
  </div>
</template>
<script>
import router from "@system.router"
import { ACCOUNT, STOCKS, formatMoney, formatPercent, trendClass } from "../../data/reviewStatic.js"
import { applyTheme, DEFAULT_STYLES } from "../../common/theme.js"
export default {
  private: {
    t: DEFAULT_STYLES,
    gameDay: 1,
    stocks: []
  },
  onInit() {
    applyTheme(this)
    this.gameDay = ACCOUNT.gameDay
    this.stocks = STOCKS.map(function (stock) {
      return {
        id: stock.id,
        name: stock.name,
        mark: stock.mark,
        avatarTone: stock.avatarTone,
        priceText: formatMoney(stock.price),
        changeText: formatPercent(stock.change),
        changeClass: "market-change " + trendClass(stock.change),
        holdingText: stock.holding.shares > 0 ? "持仓 " + stock.holding.shares + " 股" : stock.sectorName
      }
    })
  },
  onShow() {
    applyTheme(this)
  },
  back() {
    router.back()
  },
  openStock(stockId) {
    router.push({ uri: "/pages/stock-detail", params: { stockId: stockId } })
  }
}
</script>
<style>
@import "../../common/theme.css";
.stock-row { width: 320px; height: 108px; margin-bottom: 8px; padding: 12px; border-radius: 22px; flex-direction: row; align-items: center; background-color: #171717; }
.stock-logo { width: 72px; height: 72px; margin-right: 10px; border-radius: 20px; align-items: center; justify-content: center; }
.stock-mark { width: 72px; height: 72px; color: #ffffff; font-size: 42px; line-height: 72px; font-weight: bold; text-align: center; }
.avatar-blue { background-color: #102b49; }
.avatar-gold { background-color: #332b08; }
.avatar-green { background-color: #10351e; }
.avatar-red { background-color: #4a171b; }
.avatar-purple { background-color: #2d1b4e; }
.avatar-gray { background-color: #343438; }
.stock-main { width: 114px; height: 72px; flex-direction: column; justify-content: center; }
.stock-name { width: 114px; height: 35px; color: #ffffff; font-size: 28px; line-height: 35px; font-weight: bold; lines: 1; text-overflow: ellipsis; }
.price-box { width: 100px; flex-direction: column; align-items: flex-end; }
.stock-price { width: 100px; height: 35px; color: #ffffff; font-size: 28px; line-height: 35px; font-weight: bold; text-align: right; lines: 1; text-overflow: ellipsis; }
.market-change { width: 100px; height: 29px; margin-top: 3px; font-size: 22px; line-height: 29px; text-align: right; lines: 1; text-overflow: ellipsis; }
</style>